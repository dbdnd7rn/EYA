{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "vac-payments",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-19",
  "observability": {
    "enabled": true
  },
  "vars": {
    "ENVIRONMENT": "development"
  }

  // Before local D1 testing or deployment, run `npm run db:create`, allow Wrangler
  // to update this file, and use PAYMENTS_DB as the binding name.
  // See wrangler.d1.example.jsonc for the expected final structure.
}
