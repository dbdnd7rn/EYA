# Never commit real values. Copy this file to .dev.vars for local development.
PAYCHANGU_SECRET_KEY=
PAYCHANGU_WEBHOOK_SECRET=

# JSON object mapping each application id to its private HMAC secret.
# Each secret must be at least 32 characters.
# Example: {"eya":"replace-with-a-long-random-secret"}
APP_SECRETS_JSON={}

# Reserved for the signed application callback stage.
# Example: {"eya":"https://<project-ref>.supabase.co/functions/v1/payment-confirmed"}
APP_CALLBACKS_JSON={}
