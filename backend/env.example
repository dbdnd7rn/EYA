# =========================
# EYA BACKEND (VERCEL)
# =========================
# Vercel supplies PORT/runtime details. Local-only listener settings remain
# optional for npm run dev/start and are not required by the exported Vercel app.
PORT=4000
EYA_INTERNAL_PORT=

# Public URL of the deployed EYA backend. Set this to the verified Vercel
# production URL after the project is created.
PUBLIC_BASE_URL=https://YOUR-EYA-BACKEND.vercel.app

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_NEW_APP_SCHEMA=public

EXPO_PUSH_ACCESS_TOKEN=

# Optional comma-separated second allowlist for Node Admin controls.
# Database profile role remains authoritative; this only narrows access further.
ADMIN_EMAILS=

# Ticket organization payout destinations are encrypted before storage.
# Generate a dedicated 32-byte key with: openssl rand -base64 32
PAYOUT_DESTINATION_ENCRYPTION_KEY_B64=
PAYOUT_DESTINATION_ENCRYPTION_KEY_VERSION=v1

# Optional deep-link target used by application-facing redirects where relevant.
APP_SCHEME=eya

# =========================
# VAC PAYMENTS (CLOUDFLARE)
# =========================
# These values are server-only. Never expose them as EXPO_PUBLIC_* or
# NEXT_PUBLIC_* variables. The Vercel backend and/or trusted Supabase Edge
# Functions may use them to communicate with VAC Payments.
VAC_PAYMENTS_URL=https://YOUR-VAC-PAYMENTS-WORKER.workers.dev
VAC_PAYMENTS_APP_ID=eya
VAC_PAYMENTS_APP_SECRET=replace-with-32-plus-byte-secret
VAC_PAYMENTS_CALLBACK_SECRET=replace-with-dedicated-callback-secret

# PayChangu provider credentials intentionally do NOT belong in the Vercel EYA
# backend. Store PAYCHANGU_SECRET_KEY, PAYCHANGU_WEBHOOK_SECRET and the VAC app
# secret mapping only in Cloudflare/Supabase secret storage as appropriate.
