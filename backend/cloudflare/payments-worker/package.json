{
  "name": "vac-payments-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "types": "wrangler types",
    "db:create": "wrangler d1 create vac-payments",
    "db:migrations:list:local": "wrangler d1 migrations list vac-payments --local",
    "db:migrations:list:remote": "wrangler d1 migrations list vac-payments --remote",
    "db:migrate:local": "wrangler d1 migrations apply vac-payments --local",
    "db:migrate:remote": "wrangler d1 migrations apply vac-payments --remote"
  },
  "devDependencies": {
    "typescript": "^5.8.0",
    "wrangler": "^4.125.0"
  }
}
