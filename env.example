PORT=4000
# Optional loopback listener used by src/secure-entry.js. Leave empty to auto-select.
EYA_INTERNAL_PORT=

# PayChangu credentials stay on the backend only.
PAYCHANGU_SECRET_KEY=sec-live-replace-me
PAYCHANGU_PUBLIC_KEY=pub-live-replace-me
PAYCHANGU_WEBHOOK_SECRET=replace-me
PAYCHANGU_CALLBACK_URL=
PAYCHANGU_RETURN_URL=

EXPO_PUSH_ACCESS_TOKEN=
PUBLIC_BASE_URL=http://localhost:4000

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_NEW_APP_SCHEMA=public

# Optional comma-separated second allowlist for Node Admin controls.
# Database profile role remains authoritative; this only narrows access further.
ADMIN_EMAILS=

# Ticket organization payout destinations are encrypted before storage.
# Generate a dedicated 32-byte key with: openssl rand -base64 32
# Keep prior versions available during a controlled key rotation until existing
# ciphertext has been re-encrypted.
PAYOUT_DESTINATION_ENCRYPTION_KEY_B64=
PAYOUT_DESTINATION_ENCRYPTION_KEY_VERSION=v1

# Backward-compatible redirect aliases. Prefer the PAYCHANGU_* names above.
CHECKOUT_SUCCESS_URL=
CHECKOUT_CANCEL_URL=

# Optional deep-link target used by success/cancel pages.
APP_SCHEME=eya
